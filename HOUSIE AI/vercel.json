{
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/speech-assist", "destination": "/speech-assist/index.html" },
    { "source": "/speech-assist/", "destination": "/speech-assist/index.html" },
    { "source": "/speech", "destination": "/speech-assist/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
